<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>MackySoft.Moira</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>MackySoft.Moira</PackageId>
    <Version>0.0.0</Version>
    <Description>Unity-independent weighted selection primitives for .NET.</Description>
    <PackageTags>weighted;selection;probability;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Link="README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Link="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
